# Public demo deployment. Copy to `.env.public` and fill the placeholders.
#
# The public backend is started with:
#   python -m uvicorn app.main:app --host 127.0.0.1 --port 8002 --env-file .env.public
#
# Port 8001 stays the local/dev backend (normal .env, original data/, no gate).
# This public process must use its own DATA_DIR so personal workflows, runs and
# exports are never exposed by accident.
#
# Never bind 0.0.0.0 or forward a router port. Cloudflare Tunnel connects to
# 127.0.0.1 from this machine, so the existing local-auth loopback check keeps
# working and the gate is the only public door.

PUBLIC_ACCESS=true
PUBLIC_DEMO=true
PUBLIC_ORIGIN=https://demo.example.com
TRUSTED_HOSTS=demo.example.com
CORS_ORIGINS=https://demo.example.com
FRONTEND_DIST=H:/agent_scaffold/frontend/dist

# The public database is separate on purpose: personal workflows, run history,
# checkpoints, memory and exports must not be published by accident.
DATA_DIR=H:/agent_scaffold_public_data

# Local-only bind. Do not change this to 0.0.0.0.
AUTH_MODE=local
SERVER_HOST=127.0.0.1

# Generate four independent values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SALT=replace-with-at-least-32-random-characters
GATE_COOKIE_SECRET=replace-with-at-least-32-random-characters
ADMIN_TOKEN=replace-with-at-least-32-random-characters
GATE_BYPASS_TOKEN=replace-with-at-least-32-random-characters

# Cloudflare Turnstile. Leave both empty to use the built-in proof-of-work only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Gate tuning.
GATE_COOKIE_TTL_SECONDS=43200
GATE_COOKIE_SECURE=true
GATE_POW_DIFFICULTY=16
GATE_CHALLENGE_TTL_SECONDS=300

# Public demo restrictions.
CODE_NODE_ENABLED=false
SCHEDULER_ENABLED=false
TOOLS_DENYLIST=db_reset,db_update,db_delete
AI_ENABLED=true
# Self-test is a second model loop and the most expensive part of a generation.
# Leave it off for an unattended public demo; it is useful locally.
AI_SELF_TEST=false
AI_SELF_TEST_TIMEOUT_SECONDS=120
AI_MAX_TOOL_ITERATIONS=12
AI_COPILOT_MAX_TOOL_ITERATIONS=10
AI_BUSINESS_RESEARCH=false
MAX_CONCURRENT_RUNS=2
MAX_RUN_TOKENS=50000
MAX_RUN_SECONDS=90
MAX_RUN_STEPS=50
RECURSION_LIMIT=100
NODE_TIMEOUT_SECONDS=60

# Search engines used by the `web_search` tool. They must be listed here as
# well: under a TUN/proxy resolver the engine hostnames resolve to a fake-IP
# (198.18.x.x), which the egress policy would otherwise refuse as private.
# Chinese queries try Baidu -> Sogou -> 360, Latin queries DuckDuckGo -> Bing.
EGRESS_ALLOWED_HOSTS=html.duckduckgo.com,lite.duckduckgo.com,duckduckgo.com,www.bing.com,cn.bing.com,www.baidu.com,www.sogou.com,www.so.com

# Request and content limits.
MAX_REQUEST_BYTES=524288
MAX_WORKFLOWS=50
MAX_NODES_PER_WORKFLOW=80
MAX_EDGES_PER_WORKFLOW=160

# Per-IP sliding windows and the global daily AI cap.
RATE_LIMIT_ACCESS_PER_MINUTE=10
RATE_LIMIT_VERIFY_PER_MINUTE=5
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=3
RATE_LIMIT_AI_PER_DAY_GLOBAL=300
RATE_LIMIT_AI_PER_DAY_PER_VISITOR=3
RATE_LIMIT_AI_PER_DAY_PER_IP=10
RATE_LIMIT_RUNS_PER_MINUTE=5
RATE_LIMIT_RUNS_PER_DAY_PER_IP=20
RATE_LIMIT_RUNS_PER_DAY_PER_VISITOR=2
RATE_LIMIT_HOOKS_PER_MINUTE=60

# Anonymous visitor quota. The signed visitor cookie is a quota key, not a login.
# Both the visitor counter and the IP counter must allow the request.
VISITOR_COOKIE_TTL_SECONDS=2592000
VISITOR_DAILY_TOKENS=50000
IP_DAILY_TOKENS=200000
GLOBAL_DAILY_TOKENS=5000000
AI_REQUEST_TOKEN_LIMIT=30000

# Optional hard cost ceiling per run. Fill your provider's prices; 0 disables.
# MAX_RUN_COST=0.10
# INPUT_PRICE_PER_MILLION=0
# OUTPUT_PRICE_PER_MILLION=0

# Model connection. Use a dedicated key with a spending limit; this deployment
# is reachable by anyone who passes the human check.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-with-a-dedicated-key
LLM_MODEL=deepseek-flash
