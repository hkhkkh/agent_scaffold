# ============================================================================
#  Agent Scaffold — configuration template
#  Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# ============================================================================

# ---------------------------------------------------------------------- LLM
# Any OpenAI-compatible endpoint:
#   DeepSeek : https://api.deepseek.com/v1        deepseek-flash
#   OpenAI   : https://api.openai.com/v1          gpt-4o-mini
#   Ollama   : http://localhost:11434/v1          llama3.1   (api key: "ollama")
#
# Leave LLM_API_KEY empty to run in mock mode — no network calls, deterministic
# replies, useful for trying the UI before wiring up a provider.
#
# `deepseek-chat` and `deepseek-reasoner` were retired on 2026-07-24 and survive
# only as aliases for `deepseek-flash`. They still answer, which is the problem:
# the response reports the canonical model it actually served, so a stale name
# keeps working while hiding which model ran. Verified against the live endpoint
# on 2026-10-10 — `deepseek-chat` and `deepseek-flash` both return
# `"model": "deepseek-flash"`.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.0
# Native reasoning. `auto` enables DeepSeek thinking mode and leaves other
# OpenAI-compatible endpoints alone. `enabled`/`disabled` force it.
# Effort: low | high | max (DeepSeek ignores temperature in thinking mode).
LLM_THINKING=auto
LLM_REASONING_EFFORT=high

# ------------------------------------------------------------------ Runtime
# Hard ceiling on graph super-steps. Every node execution is one step, and a
# loop re-runs its body on every pass — a 40-node workflow with a 4-pass loop
# needs roughly 100. Loops without an exit are a bug, not a feature, so this is
# still enforced at the engine level and bounded by each Loop node's own
# `max_iterations`; the ceiling only has to be above a legitimate run.
RECURSION_LIMIT=300
NODE_TIMEOUT_SECONDS=120

# Code nodes execute user Python. Read the SECURITY section of the README
# before enabling this on anything other than your own machine.
CODE_NODE_ENABLED=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------------------- Auth
# The rule: authentication is off only when it is provably unnecessary.
#
# AUTH_MODE=local means "no token, because only this machine can reach me". It is
# honoured ONLY when SERVER_HOST is a loopback address. If you bind anything else
# (0.0.0.0, a LAN IP, a public name) the mode is escalated to `token`
# automatically and the server refuses to start without tokens configured.
#
# SERVER_HOST must match the address you actually bind with `uvicorn --host`.
# A mismatch is caught at runtime — a non-loopback peer is refused in local mode
# — but keeping them in sync is what makes the two checks agree.
SERVER_HOST=127.0.0.1
AUTH_MODE=local

# Required when AUTH_MODE=token (or when bound to a non-loopback address).
# Format: name:token  or  name:token:scope1|scope2
# Scopes: read (GET), write (create/edit/run), admin (settings, and therefore
# the model credentials). Separate entries with commas.
#
#   AUTH_TOKENS=admin:<a-long-random-string>:admin,reader:<another>:read
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKENS=

# Salt for token hashing. Leave blank for a stable per-installation default.
# Setting it rotates every token at once.
AUTH_SALT=

# ------------------------------------------------------------- Secrets
# Where credentials come from. See `app/security/secrets.py`.
#
# SECRETS_FILE points at a JSON object of name -> value:
#
#   {"llm.api_key": "sk-..."}
#
# When set it WINS over .env — that ordering is the feature: an exported agent
# (Phase 6) ships with its own credentials so the destination does not have to
# be configured to match the origin.
#
# A missing or malformed file is a STARTUP ERROR rather than a fallback. A
# deployment that quietly ran on the mock model would look like a working
# system, which is the worst available outcome.
#
# With this set, PUT /api/settings/llm refuses to change the key (409) instead
# of reporting success for an override that would be ignored.
# SECRETS_FILE=

# ------------------------------------------------------------------- Egress
# Outbound requests (the `http_request` tool) are filtered. By default private,
# loopback, and link-local addresses are refused, which is what stops a workflow
# from reaching cloud metadata (169.254.169.254) or scanning your LAN.
#
# EGRESS_ALLOWED_HOSTS is the narrow way to reach a specific local service;
# EGRESS_ALLOW_PRIVATE=true re-opens the whole private range and is not advised.
# Search engines used by `web_search` belong here too when a TUN/proxy resolver
# maps them to a fake private IP (198.18.x.x):
# EGRESS_ALLOWED_HOSTS=html.duckduckgo.com,lite.duckduckgo.com,duckduckgo.com,www.bing.com,cn.bing.com,www.baidu.com,www.sogou.com,www.so.com
EGRESS_ALLOWED_HOSTS=
EGRESS_ALLOW_PRIVATE=false
EGRESS_MAX_REDIRECTS=5
EGRESS_MAX_RESPONSE_BYTES=2000000

# ------------------------------------------------------------------- Tools
# Which tools an Agent or Tool node may call. See `app/tools/registry.py`.
#
# TOOLS_ALLOWLIST empty means "every registered tool", so a general-purpose agent
# stays zero-configuration. Non-empty bounds the agent to exactly those names —
# this is the form an exported agent's manifest takes.
#
# TOOLS_DENYLIST is subtracted afterwards, for switching off one capability
# without enumerating the rest:
#
#   TOOLS_DENYLIST=http_request          # a host with no outbound network
#   TOOLS_ALLOWLIST=calculator,json_query
#
# A misspelled name is a warning at startup, not an error: the agent would
# otherwise come up with no tools and nothing would say why.
TOOLS_ALLOWLIST=
TOOLS_DENYLIST=

# ------------------------------------------------------------- Code sandbox
# Which implementation of the code-execution capability this deployment gets.
# See `app/runtime/runner.py`.
#
#   local     a resource-limited child process on this host (default).
#             Bounds CPU and memory. Does NOT isolate the filesystem or the
#             network — a snippet runs as the backend's user and can reach what
#             that user can. Fine for workflows you wrote yourself.
#   container one throwaway Docker container per snippet, with --network none,
#             a read-only filesystem, dropped capabilities, and an unprivileged
#             user. The profile for untrusted or multi-tenant deployments.
#             Costs 100 ms-1 s per Code node, which is why it is not the default.
#
# An unrecognised value is a startup error rather than a silent downgrade: a typo
# must not leave you believing snippets are isolated when they are not. If the
# daemon is unavailable the run fails closed — it never falls back to local.
# SANDBOX_RUNNER=local

# Container runner only. Build it with:
#   docker build -f docker/sandbox.Dockerfile -t agent-scaffold-sandbox:latest .
# The image has not been built on every machine this scaffold has run on; see
# the header of that Dockerfile.
# SANDBOX_IMAGE=agent-scaffold-sandbox:latest

# Hard memory ceiling per snippet, in bytes. 0 (or unset) uses 512 MB.
# Applies to the local runner's job object and to the container's --memory.
# SANDBOX_MEMORY_BYTES=536870912

# Local runner only. `inprocess` runs snippets inside the API process; it exists
# for environments where spawning is impossible. A CPU-bound loop cannot be
# stopped and there is no memory limit. Do not use it with untrusted code.
# SANDBOX_MODE=subprocess

# ------------------------------------------------------------ Run history
# Where a run's history is recorded. See `app/runtime/runs.py`.
#
#   sqlite  the platform database (default). A durable record the run history
#           and history endpoints read back.
#   memory  this process only. Tests, and anything that wants history without
#           a database.
#   null    record nothing. This is what an exported agent gets: it has no
#           reader for a run history, and shipping a database to it would mean
#           the agent was never really standalone.
#
# `null` and `memory` also let the run framework be imported without loading
# SQLModel or FastAPI at all — verified, not assumed.
#
# An unrecognised value is a startup error rather than a silent fallback, for
# the same reason SANDBOX_RUNNER is: a typo must not mean "no history" is
# quietly answered with a database the deployment may not have.
# RUN_STORE=sqlite

# ----------------------------------------------------------------------- AI
# Powers "describe a node -> AI fills it in" and "describe a workflow -> AI
# drafts the graph".
AI_ENABLED=true

# Tool-calling ROUNDS for one graph generation, not tool calls. The model may
# emit many calls per round — several add_node and connect calls in one turn —
# so the ceiling is on conversational turns, not on the size of the graph.
#
# It needs to be generous, because one node costs one add_node call and one
# connection costs one connect call: a 40-node workflow is roughly 90 calls. At
# 8 rounds that workflow is not slow, it is impossible, and the failure looks
# like a model that gave up rather than a budget that ran out. The model stops
# on its own when it calls `finish`, so a high ceiling costs nothing on a small
# request.
AI_MAX_TOOL_ITERATIONS=40

# Trial-run a generated workflow before returning it. The run uses the Start
# node's own declared input defaults and executes for real — model calls, tool
# calls and side effects included — so a runtime mistake reaches the generator's
# correction loop instead of the first user. Set false to skip it.
AI_SELF_TEST=true
# Time ceiling for one trial run, in seconds. A graph that loops inside a slow
# tool is the case this exists for.
AI_SELF_TEST_TIMEOUT_SECONDS=180

# ------------------------------------------------------------ Public access
# Public deployment is a separate profile, not a flag on this file. Use
# `.env.public.example` -> `.env.public` and start uvicorn with
# `--env-file .env.public`; see docs/env/deploy.md.
#
# The important invariants:
#   * bind 127.0.0.1, never 0.0.0.0, and do not enable --proxy-headers;
#   * PUBLIC_DEMO forces CODE_NODE_ENABLED=false and SCHEDULER_ENABLED=false;
#   * GATE_COOKIE_SECRET / ADMIN_TOKEN / GATE_BYPASS_TOKEN must be 32+ chars;
#   * the public deployment uses a separate DATA_DIR.
# PUBLIC_ACCESS=false
# PUBLIC_DEMO=false
# PUBLIC_ORIGIN=https://demo.example.com
# FRONTEND_DIST=H:/agent_scaffold/frontend/dist
# GATE_COOKIE_SECRET=
# ADMIN_TOKEN=
# GATE_BYPASS_TOKEN=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# MAX_REQUEST_BYTES=1048576



# ------------------------------------------------------------ demo production line
# Local-only mock MES gateway for scripts/mock_production_line.py. Do not copy
# these into .env.public: the public demo has no Code/SQL/email and must not
# reach a local line controller.
# LINE_API_KEY=replace-with-a-random-local-key
# LINE_BASE_URL=http://127.0.0.1:8101
# EGRESS_ALLOWED_HOSTS=127.0.0.1:8101,<your-search-hosts>
