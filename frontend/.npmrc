# pnpm configuration for this package.
#
# node-linker=hoisted
#   pnpm's default `isolated` layout uses symlinks into a content-addressed
#   store. On Windows that intermittently fails with
#   `ERR_PNPM_EISDIR: illegal operation on a directory, symlink ...` — typically
#   when a previous install left a real directory where a link is expected, or
#   when the filesystem does not expose symlink privileges.
#
#   `hoisted` produces an npm-style flat node_modules with no symlinks. It costs
#   some disk space and the strictness guarantee that undeclared dependencies
#   cannot be imported; it buys an install that works every time on Windows,
#   which matters more for a scaffold people clone and run.
node-linker=hoisted

# Keep the lockfile reproducible.
resolution-mode=highest
strict-peer-dependencies=false
